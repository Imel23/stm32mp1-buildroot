BR2_arm=y
BR2_cortex_a7=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_FOOBAR_PATH)/board/bootlin/stm32mp1/patches/"
BR2_TARGET_GENERIC_HOSTNAME="stm32mp1-dk1"
BR2_TARGET_GENERIC_ISSUE="Welcome to the STM32MP157 Buildroot system"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_FOOBAR_PATH)/board/bootlin/stm32mp1/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_FOOBAR_PATH)/board/bootlin/stm32mp1/build_id_creator.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_FOOBAR_PATH)/board/bootlin/stm32mp1/genimage.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="-c $(BR2_EXTERNAL_FOOBAR_PATH)/board/bootlin/stm32mp1/genimage.cfg"
