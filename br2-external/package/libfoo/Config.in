config BR2_PACKAGE_LIBFOO
    bool "libfoo"
    help
        This is a completely stupid piece of source code doing absolutely nothing useful. 
        It is only intended to be used as an exercice for packaging software in Buildroot.
        https://github.com/tpetazzoni/libfoo
    
if BR2_PACKAGE_LIBFOO
    config BR2_PACKAGE_LIBFOO_DEBUG
        bool "enable debug feature"
        help
            Enable the debug feature of libfoo.
endif
